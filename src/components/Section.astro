---
interface Props {
  id: string;
  center?: boolean;
}

const { id, center } = Astro.props;
---

<section
  class:list={[
    "w-full lg:w-185 mx-auto pt-8 md:pt-14 pb-10 md:pb-20 lg:pb-30 min-h-screen snap-start scroll-mt-20",
    center && "flex flex-col justify-center",
  ]}
  id={id}
>
  <slot />
</section>
