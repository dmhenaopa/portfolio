---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Message sent — Diana Henao"
  description="Your message has been received. I'll get back to you soon."
>
  <main class="min-h-[80vh] flex items-center justify-center px-6">
    <div class="text-center max-w-md">
      <div class="text-5xl mb-6">✉️</div>
      <h1 class="text-3xl font-bold text-heading mb-4">Message received!</h1>
      <p class="text-body mb-8">
        Thanks for reaching out. I'll get back to you as soon as possible.
      </p>
      <a
        href={`${import.meta.env.BASE_URL}`}
        class="inline-block px-8 py-3 rounded bg-pink-camelia text-pink-reddish-purple border border-pink-reddish-purple font-medium hover:bg-soft-cherry transition-colors"
      >
        Back to portfolio
      </a>
    </div>
  </main>
</Layout>
